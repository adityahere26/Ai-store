# Required: Google AI Studio key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional: ordered model fallback chain (comma-separated)
# GEMINI_MODELS=gemini-3.5-flash,gemini-3.6-flash,gemini-3.8-flash,gemini-3.5-flash-lite

# Required in production: Upstash Redis (auto-added by the Vercel Upstash integration).
# Locally, without these, published stores live in memory until the server restarts.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional: free backup provider (https://console.groq.com/keys). Used when Gemini models are rate limited.
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional: web search for "creators to learn from" (https://tavily.com, free 1,000/month, no card)
# TAVILY_API_KEY=
